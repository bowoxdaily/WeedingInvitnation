@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Poppins:wght@300;400;500;600;700&family=Great+Vibes&display=swap');

@import 'tailwindcss';

@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
@source '../../storage/framework/views/*.php';
@source '../**/*.blade.php';
@source '../**/*.js';

@theme {
    --font-sans: 'Poppins', ui-sans-serif, system-ui, sans-serif;
    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-cursive: 'Great Vibes', cursive;

    --color-ivory: #FDFBF7;
    --color-cream-light: #FAF6F0;
    --color-cream: #F4EFE6;
    --color-champagne: #F7E7CE;
    --color-sage-100: #E8EFE7;
    --color-sage-300: #B2C5B0;
    --color-sage-500: #6B9568;
    --color-forest: #2D4A3E;
    --color-forest-dark: #1F3530;
    --color-gold: #C9A84C;
    --color-gold-light: #E8D08A;
}


/* GLOBAL */
html { scroll-behavior: smooth; overflow-x: hidden; }
body { font-family: 'Poppins', system-ui, sans-serif; background-color: #FAF6F0; color: #2D2D2D; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
h1,h2,h3,h4 { font-family: 'Cormorant Garamond', Georgia, serif; line-height: 1.2; }

.bg-cream-page { background-color: #FAF6F0; }
.bg-cream-soft { background-color: #FDFBF7; }
.bg-cream-card { background-color: #FFFDF9; }

/* GOLD GRADIENT */
.text-gold-gradient { background: linear-gradient(135deg, #C9A84C 0%, #E8D08A 50%, #C9A84C 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.bg-gold-gradient { background: linear-gradient(135deg, #C9A84C 0%, #E8D08A 50%, #C9A84C 100%); }

/* COVER PAGE */
#cover-page { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; background-color: #FAF6F0; transition: opacity 0.8s ease, visibility 0.8s ease; }
#cover-page.hidden-cover { opacity: 0; visibility: hidden; pointer-events: none; }

/* LOADING */
#loading-screen { position: fixed; inset: 0; z-index: 99999; display: flex; flex-direction: column; align-items: center; justify-content: center; background-color: #FAF6F0; transition: opacity 0.6s ease, visibility 0.6s ease; }
#loading-screen.hidden-loading { opacity: 0; visibility: hidden; pointer-events: none; }

/* ANIMATIONS */
@keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
}

@keyframes floatSlow {
    0%, 100% { transform: translateY(0) translateX(0); }
    50% { transform: translateY(-15px) translateX(10px); }
}

@keyframes pulse-glow {
    0%, 100% { opacity: 0.6; filter: brightness(1); }
    50% { opacity: 0.8; filter: brightness(1.2); }
}

@keyframes shimmer {
    0% { background-position: -1000px 0; }
    100% { background-position: 1000px 0; }
}

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-30px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes scaleIn {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
}

@keyframes sparkle {
    0%, 100% { opacity: 0; transform: scale(0); }
    50% { opacity: 1; transform: scale(1); }
}

/* Mobile responsive animations */
@media (max-width: 767px) {
    @keyframes float {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(3deg); }
    }
    
    @keyframes floatSlow {
        0%, 100% { transform: translateY(0) translateX(0); }
        50% { transform: translateY(-8px) translateX(5px); }
    }
    
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }
}

/* Floating animation for floral decorations */
.floral-float { animation: float 6s ease-in-out infinite; }
.floral-float-slow { animation: floatSlow 8s ease-in-out infinite; }
.floral-pulse { animation: pulse-glow 3s ease-in-out infinite; }

/* Stagger animation delays */
.animate-delay-100 { animation-delay: 0.1s; animation-fill-mode: both; }
.animate-delay-200 { animation-delay: 0.2s; animation-fill-mode: both; }
.animate-delay-300 { animation-delay: 0.3s; animation-fill-mode: both; }
.animate-delay-400 { animation-delay: 0.4s; animation-fill-mode: both; }
.animate-delay-500 { animation-delay: 0.5s; animation-fill-mode: both; }

/* Shimmer effect */
.shimmer-effect {
    position: relative;
    overflow: hidden;
}

.shimmer-effect::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: shimmer 3s infinite;
}

/* Responsive animations - reduce on mobile */
@media (max-width: 767px) {
    .floral-float { animation: float 8s ease-in-out infinite; }
    .floral-float-slow { animation: floatSlow 10s ease-in-out infinite; }
    .shimmer-effect::after { animation: shimmer 4s infinite; }
}

/* Reduce motion for accessibility */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

/* SECTIONS */
.section-padding { padding: 5rem 1.5rem; }
@media (min-width: 768px) { .section-padding { padding: 7rem 2rem; } }
@media (max-width: 767px) { .section-padding { padding: 3.5rem 1.25rem; } }
.section-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.5rem; font-weight: 500; color: #2D4A3E; text-align: center; margin-bottom: 0.5rem; animation: fadeInUp 0.8s ease-out; }
@media (min-width: 768px) { .section-title { font-size: 3.5rem; } }
@media (max-width: 767px) { .section-title { font-size: 2rem; } }
.section-subtitle { font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: #C9A84C; text-align: center; animation: fadeInDown 0.8s ease-out; }
.section-divider { display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 1.5rem auto 3rem; animation: scaleIn 0.6s ease-out; }
.section-divider::before,.section-divider::after { content: ''; height: 1px; width: 60px; background: linear-gradient(to right, transparent, #C9A84C); }
.section-divider::after { background: linear-gradient(to left, transparent, #C9A84C); }
.section-divider span { color: #C9A84C; animation: pulse-glow 2s ease-in-out infinite; }
.container-wedding { max-width: 900px; margin: 0 auto; width: 100%; position: relative; z-index: 2; }


/* BUTTONS */
.btn-gold { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.875rem 2.5rem; background: linear-gradient(135deg, #C9A84C 0%, #E8D08A 50%, #C9A84C 100%); color: #1F3530; font-size: 0.875rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; border: none; cursor: pointer; transition: all 0.3s ease; text-decoration: none; min-height: 48px; border-radius: 9999px; box-shadow: 0 4px 15px rgba(201,168,76,0.25); position: relative; overflow: hidden; }
.btn-gold::before { content: ''; position: absolute; top: 50%; left: 50%; width: 0; height: 0; border-radius: 50%; background: rgba(255,255,255,0.3); transform: translate(-50%, -50%); transition: width 0.6s ease, height 0.6s ease; }
.btn-gold:hover::before { width: 300px; height: 300px; }
.btn-gold:hover { background: linear-gradient(135deg, #E8D08A 0%, #C9A84C 50%, #E8D08A 100%); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(201,168,76,0.35); }
.btn-outline-gold { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.875rem 2.5rem; border: 1px solid #C9A84C; color: #C9A84C; font-size: 0.875rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; background: transparent; cursor: pointer; transition: all 0.3s ease; text-decoration: none; min-height: 48px; }
.btn-outline-gold:hover { background: #C9A84C; color: #1F3530; transform: translateY(-2px); box-shadow: 0 4px 15px rgba(201,168,76,0.3); }
.btn-forest { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.875rem 2.5rem; background-color: #2D4A3E; color: white; font-size: 0.875rem; font-weight: 500; letter-spacing: 0.05em; border: none; cursor: pointer; transition: all 0.3s ease; text-decoration: none; min-height: 48px; }
.btn-forest:hover { background-color: #1F3530; transform: translateY(-1px); }

/* COUNTDOWN */
.countdown-box { display: flex; flex-direction: column; align-items: center; min-width: 70px; }
.countdown-number { font-family: 'Cormorant Garamond', serif; font-size: 3.5rem; font-weight: 600; color: #2D4A3E; line-height: 1; }
.countdown-label { font-size: 0.625rem; letter-spacing: 0.2em; text-transform: uppercase; color: #C9A84C; margin-top: 0.5rem; }
@media (min-width: 768px) { .countdown-number { font-size: 5rem; } .countdown-box { min-width: 120px; } }
@media (max-width: 767px) { .countdown-number { font-size: 2.5rem; } .countdown-box { min-width: 60px; } }

/* GALLERY */
.gallery-item { overflow: hidden; cursor: pointer; position: relative; }
.gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
.gallery-item:hover img { transform: scale(1.08); }
.gallery-overlay { position: absolute; inset: 0; background: rgba(45,74,62,0.4); opacity: 0; transition: opacity 0.3s ease; display: flex; align-items: center; justify-content: center; }
.gallery-item:hover .gallery-overlay { opacity: 1; }

/* LIGHTBOX */
#lightbox { position: fixed; inset: 0; z-index: 99998; background: rgba(0,0,0,0.92); display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: all 0.3s ease; }
#lightbox.active { opacity: 1; visibility: visible; }
#lightbox img { max-width: 90vw; max-height: 85vh; object-fit: contain; }

/* MUSIC */
#music-btn { position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9990; width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, #C9A84C, #E8D08A); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(201,168,76,0.5); transition: all 0.3s ease; }
#music-btn:hover { transform: scale(1.1); }

/* FORMS */
.form-input { width: 100%; padding: 0.875rem 1rem; border: 1px solid rgba(201,168,76,0.4); background: #FFFDF9; font-size: 0.9375rem; color: #2D2D2D; transition: border-color 0.3s ease, box-shadow 0.3s ease; outline: none; min-height: 48px; border-radius: 8px; }
.form-input:focus { border-color: #C9A84C; box-shadow: 0 0 0 3px rgba(201,168,76,0.2); }
.form-label { display: block; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: #2D4A3E; margin-bottom: 0.5rem; font-weight: 500; }

/* TOAST */
#toast-notification { position: fixed; bottom: 5rem; left: 50%; transform: translateX(-50%) translateY(100px); z-index: 99997; padding: 0.75rem 1.5rem; background: #2D4A3E; color: white; font-size: 0.875rem; box-shadow: 0 4px 20px rgba(0,0,0,0.3); transition: transform 0.3s ease; white-space: nowrap; border-radius: 9999px; border: 1px solid #C9A84C; }
#toast-notification.show { transform: translateX(-50%) translateY(0); }

/* GUESTBOOK */
.guestbook-item { background: #FFFDF9; border-left: 4px solid #C9A84C; padding: 1.25rem 1.5rem; margin-bottom: 1rem; border-radius: 0 12px 12px 0; box-shadow: 0 4px 15px rgba(201,168,76,0.08); border-top: 1px solid rgba(201,168,76,0.15); border-right: 1px solid rgba(201,168,76,0.15); border-bottom: 1px solid rgba(201,168,76,0.15); animation: fadeInUp 0.5s ease-out; transition: all 0.3s ease; }
.guestbook-item:hover { transform: translateX(5px); box-shadow: 0 6px 20px rgba(201,168,76,0.15); }

/* Mobile - reduce slide */
@media (max-width: 767px) {
    .guestbook-item:hover { transform: translateX(3px); }
}

/* GALLERY */
.gallery-item { overflow: hidden; cursor: pointer; position: relative; border-radius: 8px; border: 2px solid rgba(201,168,76,0.2); transition: all 0.3s ease; }
.gallery-item:hover { transform: scale(1.05); border-color: rgba(201,168,76,0.5); box-shadow: 0 10px 30px rgba(201,168,76,0.2); }
.gallery-item img { transition: transform 0.4s ease; }
.gallery-item:hover img { transform: scale(1.1); }

/* Mobile - reduce hover effects */
@media (max-width: 767px) {
    .gallery-item:hover { transform: scale(1.02); }
    .gallery-item:hover img { transform: scale(1.05); }
}

/* COUPLE PHOTO */
.couple-photo { width: 200px; height: 200px; border-radius: 50%; object-fit: cover; border: 4px solid #FFFDF9; box-shadow: 0 0 0 3px #C9A84C, 0 10px 25px rgba(45,74,62,0.15); transition: all 0.4s ease; }
.couple-photo:hover { transform: scale(1.05); box-shadow: 0 0 0 4px #C9A84C, 0 15px 35px rgba(45,74,62,0.25); }

/* Mobile - subtle hover */
@media (max-width: 767px) {
    .couple-photo:hover { transform: scale(1.02); }
}

/* CARDS */
.gift-card { background: #FFFDF9; border: 1px solid rgba(201,168,76,0.3); padding: 1.75rem 1.5rem; border-radius: 12px; box-shadow: 0 4px 20px rgba(201,168,76,0.08); position: relative; overflow: hidden; transition: all 0.3s ease; }
.gift-card:hover { transform: translateY(-5px); box-shadow: 0 8px 30px rgba(201,168,76,0.15); border-color: rgba(201,168,76,0.5); }

/* Mobile - reduce lift */
@media (max-width: 767px) {
    .gift-card:hover { transform: translateY(-3px); }
}

/* FLORAL DECORATIVE OVERLAYS */
.floral-corner-tl { position: absolute; top: 0; left: 0; width: 140px; height: 140px; pointer-events: none; opacity: 0.45; z-index: 1; animation: fadeInDown 1s ease-out; }
.floral-corner-tr { position: absolute; top: 0; right: 0; width: 140px; height: 140px; pointer-events: none; opacity: 0.45; transform: scaleX(-1); z-index: 1; animation: fadeInDown 1s ease-out 0.2s; animation-fill-mode: both; }
.floral-corner-bl { position: absolute; bottom: 0; left: 0; width: 140px; height: 140px; pointer-events: none; opacity: 0.45; transform: scaleY(-1); z-index: 1; animation: fadeInUp 1s ease-out 0.4s; animation-fill-mode: both; }
.floral-corner-br { position: absolute; bottom: 0; right: 0; width: 140px; height: 140px; pointer-events: none; opacity: 0.45; transform: scale(-1); z-index: 1; animation: fadeInUp 1s ease-out 0.6s; animation-fill-mode: both; }

@media (min-width: 768px) {
  .floral-corner-tl, .floral-corner-tr, .floral-corner-bl, .floral-corner-br { width: 200px; height: 200px; opacity: 0.55; }
}
@media (min-width: 768px) { .couple-photo { width: 250px; height: 250px; } }

/* ADMIN */
.admin-sidebar { background-color: #1F3530; min-height: 100vh; }
.admin-nav-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: rgba(255,255,255,0.7); font-size: 0.875rem; font-weight: 500; transition: all 0.2s ease; text-decoration: none; border-left: 3px solid transparent; }
.admin-nav-link:hover,.admin-nav-link.active { color: white; background: rgba(255,255,255,0.08); border-left-color: #C9A84C; }
.stat-card { background: white; padding: 1.5rem; box-shadow: 0 1px 8px rgba(0,0,0,0.06); border-left: 4px solid #C9A84C; }

